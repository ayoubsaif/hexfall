{
  "name": "hexfall",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @hexfall/server --filter @hexfall/client --parallel dev",
    "dev:all": "node tools/dev-all.mjs",
    "check": "vp check && node tools/check-engine.mjs && node tools/check-assets.mjs",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "models:pieces": "node tools/stl-to-glb.mjs",
    "models:dice": "node tools/obj-to-glb.mjs",
    "cards:build": "node tools/cards-from-tiles.mjs",
    "icons:build": "node tools/icons.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
