{
  "name": "hexfall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @hexfall/server --filter @hexfall/client --parallel dev",
    "check": "vp check && node tools/check-engine.mjs && node tools/check-assets.mjs",
    "test": "vp run -r test",
    "build": "vp run -r build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
