# ---- Client (build time, public: baked into the static bundle; never put secrets here)
# WebSocket base URL of the game server
VITE_SERVER_URL=ws://localhost:8080
# Optional theme name (default: diorama)
VITE_THEME=diorama
# Optional public site URL; makes og:image / og:url / canonical absolute for link previews
VITE_SITE_URL=

# ---- Server
PORT=8080
# Use rediss:// for TLS (e.g. Upstash)
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed WebSocket origins
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development
# Web Push turn notifications (optional; all three or none). Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# e.g. VAPID_SUBJECT=mailto:you@example.com
